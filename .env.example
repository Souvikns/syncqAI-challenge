# Copy to .env before running.  cp .env.example .env

# Salt for PII tokenisation. MUST stay constant across runs or tokens change
# and re-runs stop being byte-identical. In production this comes from a
# secret manager; pinned here so the golden tests are reproducible.
MERIDIAN_PII_SALT=meridian-fixed-dev-salt-do-not-use-in-production

# The pipeline's frozen logical clock, used for anything date-relative
# (e.g. driver tenure). Ingestion never reads the wall clock - set this
# deliberately, and re-runs stay byte-identical as long as it doesn't change.
MERIDIAN_REFERENCE_DATE=2026-08-30T00:00:00+05:30

# Where the client's source files live (read only).
DATA_ROOT=./data

# Optional LLM fallback for mechanic notes the lexicon cannot classify.
# Leave as "none" to run fully deterministic with zero network calls.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

TZ=Asia/Kolkata
