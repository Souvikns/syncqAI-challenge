{
  "name": "meridian-dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.1.0" },
  "scripts": {
    "start": "bun run ingest && bun run pipeline && bun run approve",
    "ingest": "bun run src/run-ingest.ts",
    "pipeline": "bun run src/run-pipeline.ts",
    "pipeline:clean": "rm -f state/actions.db state/actions.db-wal state/actions.db-shm && bun run src/run-pipeline.ts",
    "approve": "bun run src/run-approve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "exceljs": "^4.4.0",
    "uuid": "^9.0.1",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
